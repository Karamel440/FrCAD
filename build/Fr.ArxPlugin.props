<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <TargetExt>.arx</TargetExt>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(FrObjectArxRoot)\inc;$(FrIncludeDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(FrObjectArxRoot)\lib-x64;$(FrLibraryDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>accore.lib;ac1st25.lib;acdb25.lib;acge25.lib;acad.lib;rxapi.lib;acgiapi.lib;acui25.lib;AcPal.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <ModuleDefinitionFile>$(FrObjectArxRoot)\inc\AcRxDefault.def</ModuleDefinitionFile>
    </Link>
  </ItemDefinitionGroup>
</Project>
