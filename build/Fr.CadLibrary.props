<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildProjectDirectory);$(FrObjectArxRoot)\inc;$(FrIncludeDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Lib>
      <AdditionalLibraryDirectories>$(FrLibraryDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Lib>
  </ItemDefinitionGroup>
  <Target Name="FrPublishStaticLibrary" AfterTargets="Build"
          Condition="'$(Configuration)|$(Platform)' == 'Release|x64' and '$(ConfigurationType)' == 'StaticLibrary'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(FrLibraryDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ClInclude->'%(FullPath)')" DestinationFolder="$(FrIncludeDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
